{
  "name": "nachbarin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "admin": "node scripts/cli.ts",
    "test": "vitest",
    "test:e2e": "vitest run --config scripts/e2e/vitest.config.mts",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply nachbarin --local",
    "build:client": "npm run build --workspace @imaginary-maths/nachbarin-client",
    "dev:client": "npm run dev --workspace @imaginary-maths/nachbarin-client",
    "lint": "eslint .",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "typecheck:client": "tsc --noEmit -p packages/client/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.107.1"
  }
}
